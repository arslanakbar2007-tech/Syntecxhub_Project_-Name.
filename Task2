import random
best_score = None
while True:
    print("\nNumber Guessing Game")
    print("1. Easy (1 to 10)")
    print("2. Medium (1 to 50)")
    print("3. Hard (1 to 100)")
    choice = input("Choose a difficulty (1/2/3): ")
    if choice == "1":
        maximum = 10
    elif choice == "2":
        maximum = 50
    elif choice == "3":
        maximum = 100
    else:
        print("Invalid choice. Easy difficulty selected.")
        maximum = 10
    secret_number = random.randint(1, maximum)
    attempts = 0
    print(f"I'm thinking of a number between 1 and {maximum}.")
    while True:
        try:
            guess = int(input("Enter your guess: "))
        except ValueError:
            print("Please enter a whole number.")
            continue
        if guess < 1 or guess > maximum:
            print(f"Your guess must be between 1 and {maximum}.")
            continue
        attempts += 1
        if guess < secret_number:
            print("Guess higher.")
        elif guess > secret_number:
            print("Guess lower.")
        else:
            print(f"Correct! You guessed it in {attempts} attempts.")
            if best_score is None or attempts < best_score:
                best_score = attempts
                print("That's your best score!")
            print(f"Best score: {best_score} attempts")
            break
    again = input("Would you like to play again? (y/n): ").lower()
    if again != "y":
        print("Thanks for playing!")
        break
